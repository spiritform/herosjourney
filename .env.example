# Copy this to .env, or just press the key in the top right of the page -
# that writes this same file for you after checking the key against Comfy.
#
# Make a key at platform.comfy.org -> Profile -> API Keys. It is shown once.
# .env is gitignored. The key never reaches the browser.
COMFY_API_KEY=

# Serve somewhere else (default 8800)
# PORT=8801
